# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=insurance_claims
POSTGRES_USER=insurance_app
POSTGRES_PASSWORD=your_postgres_password

DATABASE_URL=postgresql+psycopg://insurance_app:your_postgres_password@localhost:5432/insurance_claims


# Gemini
GEMINI_API_KEY=your_gemini_api_key


# Pinecone
PINECONE_API_KEY=your_pinecone_api_key
PINECONE_INDEX_NAME=your_pinecone_index_name


# Frontend development origin
FRONTEND_ORIGIN=http://localhost:5173
# Clerk backend key (server only). Authorized token origin uses FRONTEND_ORIGIN above.
CLERK_SECRET_KEY=

# Optional standalone evaluation only
LANGSMITH_API_KEY=
# LANGSMITH_ENDPOINT=
# LANGSMITH_WORKSPACE_ID=
